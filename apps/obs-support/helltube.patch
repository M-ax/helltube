diff --git a/plugins/obs-webrtc/whip-service.cpp b/plugins/obs-webrtc/whip-service.cpp
index 33690fb39..63d05b87e 100644
--- a/plugins/obs-webrtc/whip-service.cpp
+++ b/plugins/obs-webrtc/whip-service.cpp
@@ -95,4 +95,46 @@ void register_whip_service()
 		return static_cast<WHIPService *>(priv_data)->GetConnectInfo((enum obs_service_connect_info)type);
 	};
 	obs_register_service(&info);
+
+	// Helltube uses the same WHIP output, with codecs and limits supported by
+	// its room relay. A separate service ID survives service-list updates.
+	info.id = "helltube_whip";
+	info.get_name = [](void *) -> const char * {
+		return "Helltube";
+	};
+	info.get_supported_video_codecs = [](void *) -> const char ** {
+		static const char *codecs[] = {"h264", nullptr};
+		return codecs;
+	};
+	info.can_try_to_connect = [](void *priv_data) -> bool {
+		auto *service = static_cast<WHIPService *>(priv_data);
+		return service->CanTryToConnect() && !service->bearer_token.empty();
+	};
+	info.apply_encoder_settings = [](void *, obs_data_t *video, obs_data_t *audio) {
+		WHIPService::ApplyEncoderSettings(video, audio);
+		if (video) {
+			obs_data_set_string(video, "profile", "baseline");
+			obs_data_set_string(video, "rate_control", "CBR");
+			obs_data_set_int(video, "keyint_sec", 2);
+			if (obs_data_get_int(video, "bitrate") > 6000)
+				obs_data_set_int(video, "bitrate", 6000);
+		}
+		if (audio && obs_data_get_int(audio, "bitrate") > 128)
+			obs_data_set_int(audio, "bitrate", 128);
+	};
+	info.get_max_bitrate = [](void *, int *video, int *audio) {
+		if (video)
+			*video = 6000;
+		if (audio)
+			*audio = 128;
+	};
+	info.get_max_fps = [](void *, int *fps) {
+		*fps = 60;
+	};
+	info.get_supported_resolutions = [](void *, struct obs_service_resolution **resolutions, size_t *count) {
+		static struct obs_service_resolution sizes[] = {{854, 480}, {1280, 720}, {1920, 1080}};
+		*resolutions = sizes;
+		*count = sizeof(sizes) / sizeof(sizes[0]);
+	};
+	obs_register_service(&info);
 }
