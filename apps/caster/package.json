{
  "name": "helltube-caster",
  "productName": "Helltube Caster",
  "version": "0.1.2",
  "private": true,
  "description": "Native screen and application broadcasting for Helltube",
  "author": "Helltube contributors",
  "type": "module",
  "main": "main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "vite build",
    "build:native": "node scripts/build-native.js",
    "pack": "npm run build:native && npm run build && electron-builder --dir",
    "dist": "npm run build:native && npm run build && electron-builder"
  },
  "dependencies": {"ws": "^8.18.3"},
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.helltube.caster",
    "artifactName": "helltube-caster-${version}-${os}-${arch}.${ext}",
    "directories": {"output": "release"},
    "files": ["main/**", "dist/**", "assets/**", "package.json"],
    "extraResources": [{"from": "native/bin", "to": "native", "filter": ["*.exe"]}],
    "win": {"target": ["nsis", "portable"], "icon": "assets/icon.ico"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true,
      "artifactName": "helltube-caster-${version}-windows-${arch}-setup.${ext}"},
    "portable": {"artifactName": "helltube-caster-${version}-windows-${arch}-portable.${ext}"},
    "linux": {"target": ["AppImage", "deb"], "icon": "assets/icon.png", "category": "AudioVideo", "maintainer": "Helltube contributors"},
    "deb": {"depends": ["libgtk-3-0", "libnss3", "libasound2", "libgbm1", "libxss1", "libxtst6", "pulseaudio-utils", "xdg-desktop-portal"]}
  }
}
